      "query": "differences.emails.updated[?id=='3'].trash | [0]"
    },
    {
      "possible": true,
      "description": "exactly one email updated",
      "type": "jmespath",
      "expected_value": 4,
      "query": "length(differences.emails.updated[?trash == `true`])"
